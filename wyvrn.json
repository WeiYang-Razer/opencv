{
  "name": "opencv",
  "version": "4.15.0.4",
  "schemaVersion": 2,
  "kind": "DynamicLib",
  "dependencies": {
    "zlib": "^1.3.2.3",
    "libjpeg-turbo": "^3.1.4.0",
    "libpng": "^1.6.58.1",
    "protobuf": "^34.1.0.0",
    "tiff": "^4.7.2.1",
    "libwebp": { "version": "^1.6.0.1", "options": { "shared": true } },
    "openjpeg": "^2.5.4.0"
  },
  "build": {
    "system": "cmake",
    "publishPerConfig": true,
    "generator": ["Ninja Multi-Config", "Visual Studio 17 2022"],
    "configs": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"],
    "configure": [
      "-DCMAKE_RELWITHDEBINFO_POSTFIX=rd",
      "-DCMAKE_MINSIZEREL_POSTFIX=mr",
      "-DBUILD_ZLIB=OFF",
      "-DBUILD_JPEG=OFF",
      "-DBUILD_PNG=OFF",
      "-DBUILD_PROTOBUF=OFF",
      "-DPROTOBUF_UPDATE_FILES=ON",
      "-DBUILD_TIFF=OFF",
      "-DBUILD_WEBP=OFF",
      "-DBUILD_OPENJPEG=OFF",
      "-DBUILD_TESTS=OFF",
      "-DBUILD_PERF_TESTS=OFF",
      "-DBUILD_opencv_apps=OFF",
      "-DBUILD_DOCS=OFF",
      "-DBUILD_EXAMPLES=OFF"
    ],
    "buildArgs": ["--parallel"],
    "installDir": "install",
    "sourceSubdir": "."
  },
  "conf": {
    "cmake": {
      "cache": {
        "WYVRN_UNICODE": "OFF"
      }
    }
  },
  "compatibility": {
    "compiler.cppstd": "lte"
  }
}
